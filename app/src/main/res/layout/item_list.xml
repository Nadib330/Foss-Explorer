<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@+id/rootView"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingVertical="@dimen/spacing_xsmall"
    android:paddingHorizontal="@dimen/spacing_large">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Material3.CardView.Outlined"
        app:cardCornerRadius="@dimen/spacing_large"
        android:id="@+id/item_CardViewItem"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/listPreferredItemHeightSmall"
        android:minHeight="?android:attr/listPreferredItemHeightSmall">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/item_cardView"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="@dimen/spacing_xlarge"
                android:layout_height="@dimen/spacing_xlarge"
                android:layout_alignParentStart="true"
                android:layout_centerInParent="true"
                android:layout_marginStart="@dimen/spacing_medium"
                android:backgroundTint="@android:color/transparent"
                app:cardCornerRadius="@dimen/spacing_xsmall">

                <ImageView
                    android:id="@+id/icon_start"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_edit"
                    tools:ignore="ContentDescription" />

            </com.google.android.material.card.MaterialCardView>

            <!-- RECHTER BEREICH: Der neue Widget-Container sauber am rechten Rand verankert -->
            <LinearLayout
                android:id="@+id/widgetContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:layout_centerInParent="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Die neue Checkbox, standardmäßig unsichtbar -->
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/item_checkBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null"
                    android:visibility="gone" />

                <!-- Das originale IconView aus deiner funktionierenden Version -->
                <ImageView
                    android:id="@+id/icon_end"
                    android:layout_width="@dimen/spacing_xlarge"
                    android:layout_height="@dimen/spacing_xlarge"
                    android:contentDescription="@null"
                    android:layout_marginEnd="@dimen/spacing_medium"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_delete"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- MITTLERER BEREICH: TextGroup stoppt jetzt sauber VOR dem gesamten Widget-Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/textGroup"
                android:orientation="vertical"
                android:layout_toEndOf="@id/item_cardView"
                android:layout_toStartOf="@id/widgetContainer"
                android:layout_centerInParent="true"
                android:layout_marginBottom="@dimen/spacing_xsmall"
                android:layout_marginTop="@dimen/spacing_xsmall"
                android:layout_marginStart="@dimen/spacing_small"
                android:layout_marginEnd="@dimen/spacing_small">

                <TextView
                    android:id="@+id/titleView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_xxsmall"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:scrollHorizontally="true"
                    android:includeFontPadding="false"
                    android:textStyle="bold"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <TextView
                    android:id="@+id/dateView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:scrollHorizontally="true"
                    android:includeFontPadding="false"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOutline" />

            </LinearLayout>

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>