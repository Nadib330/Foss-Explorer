<?xml version="1.0" encoding="utf-8"?>
<!-- 18.3.0 beta (item 15): the version page of the second screenshot — the back arrow and the ⓘ
     at the top, the name of the browser and its version in the middle, and the pills at the foot
     ("GitHub" where the screenshot has "Terms and conditions"). Colours are Explorer's own. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true">

    <ImageButton
        android:id="@+id/update_back"
        android:layout_width="@dimen/bar_button_size"
        android:layout_height="@dimen/bar_button_size"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/spacing_small"
        android:layout_marginTop="@dimen/spacing_medium"
        android:background="@drawable/bg_ripple_small"
        android:contentDescription="@string/app_cancel"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/icon_arrow_back"
        app:tint="?attr/colorOnSurface" />

    <ImageButton
        android:id="@+id/update_info"
        android:layout_width="@dimen/bar_button_size"
        android:layout_height="@dimen/bar_button_size"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/spacing_medium"
        android:layout_marginEnd="@dimen/spacing_small"
        android:background="@drawable/bg_ripple_small"
        android:contentDescription="@string/update_info_title"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/icon_info"
        app:tint="?attr/colorOnSurface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_large"
        android:paddingTop="120dp"
        android:paddingBottom="@dimen/spacing_xlarge">

        <TextView
            android:id="@+id/update_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="?attr/colorOnSurface"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/update_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/update_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/update_action"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:text="@string/update_download_short"
            android:textSize="18sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/update_github"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/update_github"
            android:textSize="18sp"
            app:backgroundTint="?attr/colorSurfaceContainerHighest"
            app:cornerRadius="32dp"
            app:icon="@drawable/icon_github"
            app:iconGravity="textTop"
            app:iconPadding="0dp"
            app:iconSize="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/update_licenses"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/update_licenses"
            android:textSize="18sp"
            app:backgroundTint="?attr/colorSurfaceContainerHighest"
            app:cornerRadius="32dp" />
    </LinearLayout>
</FrameLayout>
