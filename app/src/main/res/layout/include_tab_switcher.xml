<?xml version="1.0" encoding="utf-8"?>
<!-- The tab switcher, laid out as the one in the screenshot of 18.0.0 beta 5:
     a row with the way back, the title "Tabs", the search and the menu; then — only while the
     search is open — the search field in place of that row; then the cards of the tabs; and at
     the foot a floating pill with the tabs (their number) and the private tabs, and beside it the
     rounded-square button for a new tab.
     18.0.0 beta 6 (item 2): both float flat — a 2D surface with a hairline edge and no shadow, so
     that they read as part of the page and not as something lying on top of it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tab_switcher"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- The title row: back, "Tabs", search, menu. -->
    <FrameLayout
        android:id="@+id/tabs_title_row"
        android:layout_width="match_parent"
        android:layout_height="64dp">

        <ImageButton
            android:id="@+id/tabs_back"
            android:layout_width="@dimen/bar_button_size_compact"
            android:layout_height="@dimen/bar_button_size_compact"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="@dimen/spacing_xsmall"
            android:background="@drawable/bg_ripple_small"
            android:contentDescription="@string/app_cancel"
            android:src="@drawable/icon_arrow_back"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tabs_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="52dp"
            android:text="@string/tabs_mode_normal"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/tabs_search_button"
            android:layout_width="@dimen/bar_button_size_compact"
            android:layout_height="@dimen/bar_button_size_compact"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="@dimen/bar_button_size_compact"
            android:background="@drawable/bg_ripple_small"
            android:contentDescription="@string/cr_hub_search_hint"
            android:src="@drawable/icon_search"
            app:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/tabs_menu"
            android:layout_width="@dimen/bar_button_size_compact"
            android:layout_height="@dimen/bar_button_size_compact"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="@dimen/spacing_xsmall"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/bar_menu"
            android:src="@drawable/icon_more_vert"
            app:tint="?attr/colorOnSurface" />
    </FrameLayout>

    <!-- The search: it takes the place of the title row while it is open, as in Chrome. -->
    <LinearLayout
        android:id="@+id/tabs_search_row"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_xsmall"
        android:paddingEnd="@dimen/spacing_large"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/tabs_search_back"
            android:layout_width="@dimen/bar_button_size_compact"
            android:layout_height="@dimen/bar_button_size_compact"
            android:background="@drawable/bg_ripple_small"
            android:contentDescription="@string/app_cancel"
            android:src="@drawable/icon_arrow_back"
            app:tint="?attr/colorOnSurface" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/spacing_small"
            android:layout_weight="1"
            android:background="@drawable/bg_tabs_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_large"
            android:paddingEnd="@dimen/spacing_small">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/icon_search"
                app:tint="?attr/colorOnSurfaceVariant" />

            <EditText
                android:id="@+id/tabs_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/spacing_small"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/cr_hub_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/tabs_search_clear"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_ripple_small"
                android:contentDescription="@string/search_clear"
                android:src="@drawable/icon_cross"
                android:visibility="gone"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- The inactive section: tabs that were not used for long (Settings > Tabs and groups).
         Shown above the cards of the normal tabs while there are any. -->
    <TextView
        android:id="@+id/tabs_inactive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_large"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginEnd="@dimen/spacing_large"
        android:background="@drawable/bg_inactive_tabs"
        android:drawablePadding="@dimen/spacing_medium"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:paddingStart="@dimen/spacing_large"
        android:paddingEnd="@dimen/spacing_large"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurface"
        android:visibility="gone"
        app:drawableEndCompat="@drawable/icon_right"
        app:drawableStartCompat="@drawable/icon_history"
        app:drawableTint="?attr/colorOnSurfaceVariant" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tabs_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/spacing_small"
            android:paddingTop="@dimen/spacing_small"
            android:paddingEnd="@dimen/spacing_small"
            android:paddingBottom="@dimen/spacing_large" />

        <TextView
            android:id="@+id/tabs_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:drawablePadding="@dimen/spacing_medium"
            android:gravity="center"
            android:text="@string/tabs_empty_private"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            app:drawableTint="?attr/colorOnSurfaceVariant"
            app:drawableTopCompat="@drawable/icon_private" />

    </FrameLayout>

    <!-- The foot: one pill for the tabs and the private tabs, and the rounded-square new-tab button.
         18.0.0 beta 5, after the screenshot: the right button of the pill is the private tabs,
         with the mask Explorer already uses for them. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacing_large"
        android:paddingTop="@dimen/spacing_small"
        android:paddingEnd="@dimen/spacing_large"
        android:paddingBottom="@dimen/spacing_medium">

        <!-- 18.1.0 beta (item 4): Material 3, without the outline of beta 6: the pill is a filled
             surface of the third tone (surfaceContainerHigh), and the hairline is gone — a filled
             shape of Material 3 has no edge drawn round it. 18.2.0 beta (item 1): it is a rounded
             rectangle (16 dp) rather than a capsule. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tabs_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/tabs_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tabs_mode_normal"
                        style="@style/TabSwitcherModeButton"
                        android:contentDescription="@string/tabs_mode_normal" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tabs_mode_private"
                        style="@style/TabSwitcherModeButton"
                        android:contentDescription="@string/tabs_mode_private"
                        app:icon="@drawable/icon_private" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 18.1.0 beta (item 4): a rounded square of the same shape as the "+" of the toolbar
             (40 × 40 dp, 12 dp corners) matching the rounded square in the bottom bar, so that the
             two ways of opening a tab look like one another.
             18.2.0 beta (item 1): the surface of it is a third of a step darker than the page
             again — `colorSurfaceBright` was so close to the background that the rounded square
             could not be seen at all. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tabs_fab_card"
            android:layout_width="@dimen/new_tab_button_size"
            android:layout_height="@dimen/new_tab_button_size"
            android:layout_gravity="end|center_vertical"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageButton
                android:id="@+id/tabs_fab"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/bg_bottom_new_tab"
                android:contentDescription="@string/menu_new_tab"
                android:padding="8dp"
                android:src="@drawable/icon_plus"
                app:tint="?attr/colorOnSurface" />
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

</LinearLayout>
