<?xml version="1.0" encoding="utf-8"?>
<!-- Top bar: back arrow, address pill (site name in the middle, share at its
     end) and the menu button. Lives in @id/topBar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appBar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="1dp"
    android:paddingEnd="1dp">

    <ImageButton
        android:id="@+id/button_back"
        android:layout_width="@dimen/bar_button_size_compact"
        android:layout_height="@dimen/bar_button_size"
        android:background="@drawable/bg_ripple_small"
        android:contentDescription="@string/bar_back"
        android:src="@drawable/icon_arrow_back"
        app:tint="?attr/colorOnSurface" />

    <!-- Extra navigation actions used by the landscape browsing arrangement. -->
    <ImageButton
        android:id="@+id/button_forward_landscape"
        android:layout_width="@dimen/bar_button_size_compact"
        android:layout_height="@dimen/bar_button_size"
        android:background="@drawable/bg_ripple_small"
        android:contentDescription="@string/menu_nav_forward"
        android:src="@drawable/icon_arrow_forward"
        android:visibility="gone"
        app:tint="?attr/colorOnSurface" />

    <ImageButton
        android:id="@+id/button_home_landscape"
        android:layout_width="@dimen/bar_button_size_compact"
        android:layout_height="@dimen/bar_button_size"
        android:background="@drawable/bg_ripple_small"
        android:contentDescription="@string/bar_home"
        android:src="@drawable/icon_house"
        android:visibility="gone"
        app:tint="?attr/colorOnSurface" />

    <FrameLayout
        android:id="@+id/addressPill"
        android:layout_width="0dp"
        android:layout_height="@dimen/address_pill_height"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:layout_weight="1"
        android:background="@drawable/bg_address_pill"
        android:clickable="true"
        android:focusable="true">

        <!-- Start of the pill: the loading ring while a page loads, the reload
             button otherwise. As wide as the share button, so that the site
             name is centred. -->
        <FrameLayout
            android:layout_width="@dimen/address_pill_height"
            android:layout_height="match_parent"
            android:layout_gravity="start">

            <ImageButton
                android:id="@+id/button_reload"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_ripple_small"
                android:contentDescription="@string/bar_reload"
                android:src="@drawable/icon_refresh"
                app:tint="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/menu_progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                app:indicatorSize="20dp"
                app:trackThickness="2dp" />
        </FrameLayout>

        <!-- Middle: the site name, with the private-tab mark in front of it. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/address_pill_height"
            android:layout_marginEnd="@dimen/address_pill_height"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/icon_private"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="@dimen/spacing_small"
                android:contentDescription="@string/private_tab"
                android:src="@drawable/icon_private"
                android:visibility="gone"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/appBar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/button_share"
            android:layout_width="@dimen/address_pill_height"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@drawable/bg_ripple_small"
            android:contentDescription="@string/menu_share_link"
            android:src="@drawable/icon_share"
            app:tint="?attr/colorOnSurfaceVariant" />

    </FrameLayout>

    <ImageButton
        android:id="@+id/button_bookmark_landscape"
        android:layout_width="@dimen/bar_button_size_compact"
        android:layout_height="@dimen/bar_button_size"
        android:background="@drawable/bg_ripple_small"
        android:contentDescription="@string/menu_save_bookmark"
        android:src="@drawable/icon_bookmark"
        android:visibility="gone"
        app:tint="?attr/colorOnSurface" />

    <FrameLayout
        android:id="@+id/button_tabs_landscape"
        android:layout_width="@dimen/bar_button_size_compact"
        android:layout_height="@dimen/bar_button_size"
        android:background="@drawable/bg_ripple_small"
        android:clickable="true"
        android:contentDescription="@string/album_title_tab"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/tab_count_landscape"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_tab_counter"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- The shield, as in Firefox: what is blocked on this site, and the switch for it.
         18.0.0 beta 4: it keeps its place even when there is nothing to show, so that the profile
         and the menu beside it never move by the width of a button. -->
    <ImageButton
        android:id="@+id/button_shield"
        android:layout_width="@dimen/bar_button_size_compact"
        android:layout_height="@dimen/bar_button_size"
        android:background="@drawable/bg_ripple_small"
        android:contentDescription="@string/protection_panel_etp_toggle_label"
        android:src="@drawable/icon_shield"
        android:visibility="gone"
        app:tint="?attr/colorOnSurface" />

    <!-- 18.0.0 beta 2: the profile in front, left of the three-dot menu: the picture the user
         chose (or the letter of the profile in its colour). Tapping it opens the profiles. -->
    <ImageButton
        android:id="@+id/button_profile"
        android:layout_width="@dimen/bar_button_size_compact"
        android:layout_height="@dimen/bar_button_size"
        android:background="@drawable/bg_ripple_small"
        android:contentDescription="@string/profiles_title"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/icon_person"
        app:tint="?attr/colorOnSurface" />

    <ImageButton
        android:id="@+id/button_menu"
        android:layout_width="@dimen/bar_button_size_compact"
        android:layout_height="@dimen/bar_button_size"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/bar_menu"
        android:src="@drawable/icon_more_vert"
        app:tint="?attr/colorOnSurface" />

</LinearLayout>
