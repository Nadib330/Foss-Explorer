<?xml version="1.0" encoding="utf-8"?>
<!-- Address and search entry. Covers the whole screen while the address is
     being edited: the field on top, where the address bar is, and the
     suggestions as a plain list below it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clickable="true"
    android:elevation="@dimen/spacing_small"
    android:focusable="false"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/search_field"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bar_button_size"
        android:layout_marginHorizontal="@dimen/spacing_small"
        android:layout_marginVertical="@dimen/spacing_small"
        android:background="@drawable/bg_search_field"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/search_back"
            android:layout_width="@dimen/bar_button_size"
            android:layout_height="@dimen/bar_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/app_cancel"
            android:src="@drawable/icon_arrow_back"
            app:tint="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/main_omnibox_input_hint"
            android:imeOptions="actionGo|flagNoExtractUi"
            android:inputType="textUri"
            android:maxLines="1"
            android:padding="0dp"
            android:selectAllOnFocus="true"
            android:textAlignment="viewStart"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColorHint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/search_clear"
            android:layout_width="@dimen/bar_button_size"
            android:layout_height="@dimen/bar_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_clear"
            android:src="@drawable/icon_close"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- What was typed, as the first suggestion: a tap searches for it or opens it. -->
    <LinearLayout
        android:id="@+id/search_query_row"
        android:layout_width="match_parent"
        android:layout_height="@dimen/library_row_height"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/spacing_xlarge"
            android:layout_height="@dimen/spacing_xlarge"
            android:importantForAccessibility="no"
            android:src="@drawable/icon_search"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/search_query_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list_search"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null" />

        <View
            android:id="@+id/scrollDividerTop"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="top"
            android:background="?attr/colorOutlineVariant"
            android:visibility="invisible" />

        <View
            android:id="@+id/scrollDividerBottom"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="bottom"
            android:background="?attr/colorOutlineVariant"
            android:visibility="invisible" />
    </FrameLayout>
</LinearLayout>
