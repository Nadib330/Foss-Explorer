<?xml version="1.0" encoding="utf-8"?>
<!-- Covers the private tabs while they are locked ("Lock Incognito tabs when you leave
     Explorer"), as Chrome's Incognito re-authentication page: the sign, "Unlock Incognito"
     and "See other tabs". Shown and hidden by BrowserActivity.updateIncognitoLock. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/incognito_lock"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainer"
    android:clickable="true"
    android:elevation="24dp"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/spacing_xlarge"
    android:visibility="gone">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:importantForAccessibility="no"
        android:src="@drawable/icon_private"
        app:tint="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/incognito_unlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xlarge"
        android:text="@string/cr_incognito_unlock"
        app:icon="@drawable/icon_lock" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/incognito_see_other_tabs"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:text="@string/cr_incognito_see_other_tabs" />
</LinearLayout>
