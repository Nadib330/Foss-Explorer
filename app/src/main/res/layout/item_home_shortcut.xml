<?xml version="1.0" encoding="utf-8"?>
<!-- One tile on the home page: a round site icon with the site name below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_xsmall"
    android:paddingVertical="@dimen/spacing_small">

    <FrameLayout
        android:layout_width="@dimen/home_tile_size"
        android:layout_height="@dimen/home_tile_size"
        android:background="@drawable/bg_home_tile">

        <ImageView
            android:id="@+id/home_tile_icon"
            android:layout_width="@dimen/home_tile_icon_size"
            android:layout_height="@dimen/home_tile_icon_size"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            tools:ignore="ContentDescription" />

    </FrameLayout>

    <TextView
        android:id="@+id/home_tile_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurface"
        tools:text="Wikipedia" />

</LinearLayout>
