<?xml version="1.0" encoding="utf-8"?>
<!-- Shared floating-pill selector for Settings and the first-launch home-page prompt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_large"
    android:paddingTop="@dimen/spacing_medium"
    android:paddingBottom="@dimen/spacing_medium">

    <TextView
        android:id="@+id/home_style_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/home_style_group"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface" />

    <FrameLayout
        android:id="@+id/home_style_pill"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="@dimen/spacing_small"
        android:background="@drawable/bg_home_style_bar"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="4dp">

        <View
            android:id="@id/spring_pill_thumb"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/home_style_group"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_style_classic_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:text="@string/home_style_classic"
                android:textSize="16sp"
                app:cornerRadius="28dp"
                app:strokeWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_style_new_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:text="@string/home_style_new"
                android:textSize="16sp"
                app:cornerRadius="28dp"
                app:strokeWidth="0dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </FrameLayout>
</LinearLayout>
