<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom bar: home, new tab and the tab counter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottomBar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/bottom_bar_height"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <ImageButton
            android:id="@+id/button_home"
            android:layout_width="@dimen/bar_button_size"
            android:layout_height="@dimen/bar_button_size"
            android:layout_gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/bar_home"
            android:src="@drawable/icon_house"
            app:tint="?attr/colorOnSurfaceVariant" />

    </FrameLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <ImageButton
            android:id="@+id/button_newTab"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_bottom_new_tab"
            android:contentDescription="@string/menu_new_tab"
            android:src="@drawable/icon_plus"
            app:tint="?attr/colorOnSurface" />

    </FrameLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/button_tabs"
            android:layout_width="@dimen/bar_button_size"
            android:layout_height="@dimen/bar_button_size"
            android:layout_gravity="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/album_title_tab"
            android:focusable="true"
            tools:ignore="UselessParent">

            <TextView
                android:id="@+id/tab_count"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_tab_counter"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:textStyle="bold" />

        </FrameLayout>

    </FrameLayout>

</LinearLayout>
