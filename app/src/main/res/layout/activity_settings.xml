<?xml version="1.0" encoding="utf-8"?>
<!-- Shared by the settings screens: title bar, an optional search field
     (main screen only) and the list of setting cards. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainer"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            app:titleTextAppearance="?attr/textAppearanceHeadlineSmall" />

        <LinearLayout
            android:id="@+id/settings_search"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="@dimen/settings_card_margin"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:layout_marginEnd="@dimen/settings_card_margin"
            android:layout_marginBottom="@dimen/spacing_xsmall"
            android:background="@drawable/bg_settings_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/icon_search"
                app:tint="?attr/colorOnSurface" />

            <EditText
                android:id="@+id/settings_search_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/settings_search_hint"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColorHint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/settings_search_clear"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/spacing_xsmall"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_search_clear"
                android:src="@drawable/icon_close"
                android:visibility="gone"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- Kept for the code shared with the dialogs; never drawn. -->
        <View
            android:id="@+id/scrollDividerTop"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <TextView
            android:id="@+id/settings_search_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/settings_search_empty"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/content_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:id="@+id/scrollDividerBottom"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
