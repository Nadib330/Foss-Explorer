<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/searchOnSiteLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainer"
    android:clickable="true"
    android:gravity="center_vertical"
    android:visibility="gone">

    <!-- Find in page. Covers the address bar inside @id/topBar while open. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        android:layout_alignParentBottom="true"/>

    <Button
        android:id="@+id/searchOnSite_buttonHide"
        style="@style/Widget.Material3.Button.IconButton.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerInParent="true"
        android:layout_marginStart="@dimen/spacing_large"
        android:backgroundTint="?attr/colorSurfaceContainerHighest"
        app:icon="@drawable/icon_show" />

    <Button
        android:id="@+id/searchOnSite_buttonClose"
        style="@style/Widget.Material3.Button.IconButton.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerInParent="true"
        android:layout_marginEnd="@dimen/spacing_large"
        android:backgroundTint="?attr/colorSurfaceContainerHighest"
        app:icon="@drawable/icon_close" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/searchOnSite_textField"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/searchOnSite_buttonHide"
        android:layout_toStartOf="@+id/searchOnSite_buttonClose"
        android:paddingHorizontal="@dimen/spacing_small"
        android:paddingVertical="@dimen/spacing_xsmall"
        android:hint="@string/menu_other_searchSite"
        app:boxCornerRadiusTopStart="@dimen/spacing_large"
        app:boxCornerRadiusTopEnd="@dimen/spacing_large"
        app:boxCornerRadiusBottomStart="@dimen/spacing_large"
        app:boxCornerRadiusBottomEnd="@dimen/spacing_large"
        app:boxStrokeWidth="0.5dp"
        app:boxStrokeWidthFocused="0.5dp"
        app:startIconDrawable="@drawable/icon_up"
        app:endIconDrawable="@drawable/icon_down"
        app:endIconMode="custom">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/searchOnSite_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text|textUri"
            android:selectAllOnFocus="true"/>

    </com.google.android.material.textfield.TextInputLayout>

</RelativeLayout>
