<?xml version="1.0" encoding="utf-8"?>
<!-- The compact New home page: the Explorer name, search field and four shortcuts. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_new_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <com.rpooi3.explorer.view.MaxWidthFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:maxWidth="@dimen/home_max_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_large"
            android:paddingTop="72dp"
            android:paddingBottom="96dp">

            <!-- The software name replaces the old day/date pill, clock and greeting. -->
            <TextView
                android:id="@+id/home_new_clock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/app_name"
                android:textColor="?attr/colorPrimary"
                android:textSize="64sp"
                android:textStyle="bold" />

            <!-- The search field, with the arrow that goes. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/home_new_search"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="@dimen/spacing_xlarge"
                android:clickable="true"
                android:contentDescription="@string/main_omnibox_input_hint"
                android:focusable="true"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:cardCornerRadius="32dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_xlarge"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:text="@string/main_omnibox_input_hint"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <ImageButton
                        android:id="@+id/home_new_search_arrow"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_home_search_arrow"
                        android:contentDescription="@string/main_omnibox_input_hint"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_arrow_forward"
                        app:tint="?attr/colorOnSecondaryContainer" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Four shortcuts, two to a row, filled in by HomePageView. -->
            <LinearLayout
                android:id="@+id/home_new_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xlarge"
                android:orientation="vertical" />

        </LinearLayout>
    </com.rpooi3.explorer.view.MaxWidthFrameLayout>
</ScrollView>
