<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Privacy and security, in the order of Chromium's privacy_preferences.xml:
     "Privacy" with Delete browsing data, Preload pages and the Incognito lock;
     "Security" with Safe Browsing and JavaScript optimization & security. -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:key="privacy_group" android:title="@string/cr_privacy_section_title">

        <Preference
            android:key="settings_clear"
            android:summary="@string/cr_clear_browsing_data_summary"
            android:title="@string/cr_clear_browsing_data_title" />

        <Preference
            android:key="section_preload"
            android:title="@string/cr_preload_pages_title" />

        <SwitchPreferenceCompat
            android:key="incognito_lock"
            android:summary="@string/cr_incognito_lock_summary_on"
            android:title="@string/cr_incognito_lock_title"
            android:defaultValue="false"
            android:widgetLayout="@layout/preference_switch_widget" />

    </PreferenceCategory>

    <!-- 18.0.0 beta 8 (item 3): the section of the switches that say what is deleted when the
         browser is closed; read in ExitClear (see privacy/ClearOnExit.kt). -->
    <PreferenceCategory android:key="advanced_group" android:title="@string/cr_advanced_section_title">

        <Preference
            android:key="clear_on_exit_header"
            android:persistent="false"
            android:selectable="false"
            android:summary="@string/clear_on_exit_summary"
            android:title="@string/clear_on_exit_title" />

        <SwitchPreferenceCompat
            android:key="clear_on_exit_cache"
            android:defaultValue="false"
            android:summary="@string/clear_on_exit_cache_summary"
            android:title="@string/clear_on_exit_cache"
            android:widgetLayout="@layout/preference_switch_widget" />

        <SwitchPreferenceCompat
            android:key="clear_on_exit_tabs"
            android:defaultValue="false"
            android:summary="@string/clear_on_exit_tabs_summary"
            android:title="@string/clear_on_exit_tabs"
            android:widgetLayout="@layout/preference_switch_widget" />

        <SwitchPreferenceCompat
            android:key="clear_on_exit_history"
            android:defaultValue="false"
            android:summary="@string/clear_on_exit_history_summary"
            android:title="@string/clear_on_exit_history"
            android:widgetLayout="@layout/preference_switch_widget" />

        <SwitchPreferenceCompat
            android:key="clear_on_exit_webstorage"
            android:defaultValue="false"
            android:summary="@string/clear_on_exit_webstorage_summary"
            android:title="@string/clear_on_exit_webstorage"
            android:widgetLayout="@layout/preference_switch_widget" />

        <SwitchPreferenceCompat
            android:key="clear_on_exit_appcache"
            android:defaultValue="false"
            android:summary="@string/clear_on_exit_appcache_summary"
            android:title="@string/clear_on_exit_appcache"
            android:widgetLayout="@layout/preference_switch_widget" />

    </PreferenceCategory>

    <PreferenceCategory android:key="security_group" android:title="@string/cr_security_section_title">

        <Preference
            android:key="section_safe_browsing"
            android:title="@string/cr_safe_browsing_title" />


    </PreferenceCategory>

</PreferenceScreen>
