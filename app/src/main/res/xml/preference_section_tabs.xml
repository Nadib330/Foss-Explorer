<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Tabs and groups (Chromium: tabs_settings.xml). Of Chromium's rows the one that
     Explorer can honour: when tabs move to the inactive section. -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory>

        <Preference
            android:key="section_inactive_tabs"
            android:title="@string/cr_archive_section_title" />

    </PreferenceCategory>

</PreferenceScreen>
