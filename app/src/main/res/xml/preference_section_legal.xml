<?xml version="1.0" encoding="utf-8"?>
<!-- About > Legal information (Chromium: legal_information_preferences.xml): the licences of the
     app, the components it carries, and where the source code is. -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory>

        <Preference
            android:key="about_license"
            android:summary="@string/about_license_summary"
            android:title="@string/about_license_title" />

        <Preference
            android:key="about_license_gpl"
            android:summary="@string/about_license_gpl_summary"
            android:title="@string/about_license_gpl" />

        <Preference
            android:key="about_license_agpl"
            android:summary="@string/about_license_agpl_summary"
            android:title="@string/about_license_agpl" />

        <Preference
            android:key="about_third_party"
            android:summary="@string/about_components_summary"
            android:title="@string/about_components_title" />

    </PreferenceCategory>

    <PreferenceCategory>

        <Preference
            android:key="about_source"
            android:summary="@string/about_source_summary"
            android:title="@string/about_source_title" />

        <!-- The engines and browsers this app is built on, above FOSS Browser's link (15.2.1). -->
        <Preference
            android:key="about_source_chromium"
            android:summary="@string/about_source_chromium_summary"
            android:title="@string/about_source_chromium_title" />

        <Preference
            android:key="about_source_firefox"
            android:summary="@string/about_source_firefox_summary"
            android:title="@string/about_source_firefox_title" />

        <Preference
            android:key="about_source_upstream"
            android:summary="@string/about_source_upstream_summary"
            android:title="@string/about_source_upstream_title" />

    </PreferenceCategory>

</PreferenceScreen>
