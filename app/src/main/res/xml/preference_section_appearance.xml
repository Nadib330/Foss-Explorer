<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Appearance. -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory>

        <ListPreference
            android:defaultValue="1"
            android:icon="@drawable/icon_theme"
            android:entries="@array/setting_entries_theme"
            android:entryValues="@array/setting_values_theme"
            android:key="sp_theme"
            android:title="@string/setting_theme"
            app:useSimpleSummaryProvider="true" />

        <CheckBoxPreference
            android:defaultValue="true"
            android:icon="@drawable/icon_color"
            android:key="useDynamicColor"
            android:summary="@string/setting_title_dynColors" />

    </PreferenceCategory>

</PreferenceScreen>
