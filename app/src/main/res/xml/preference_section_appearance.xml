<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > Appearance. -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory>

        <ListPreference
            android:defaultValue="1"
            android:icon="@drawable/icon_theme"
            android:entries="@array/setting_entries_theme"
            android:entryValues="@array/setting_values_theme"
            android:key="sp_theme"
            android:title="@string/setting_theme"
            app:useSimpleSummaryProvider="true" />


    </PreferenceCategory>

    <!-- 18.0.0 beta 9 (item 7): the colors of Chromium's own color picker. -->
    <PreferenceCategory android:key="appearance_colors_group" android:title="@string/appearance_colors_group">

        <Preference
            android:key="theme_colors"
            android:icon="@drawable/icon_palette"
            android:summary="@string/theme_colors_summary"
            android:title="@string/theme_colors" />

    </PreferenceCategory>

</PreferenceScreen>
