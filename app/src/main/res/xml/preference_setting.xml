<?xml version="1.0" encoding="utf-8"?>
<!-- The first settings screen, arranged like Chrome's: one entry per topic,
     title only. Each entry opens the settings of its topic on a screen of its
     own; see SettingsSections for which one. Groups have no headings
     (SettingsCards draws them as rounded blocks). -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory>

        <Preference
            android:icon="@drawable/icon_search"
            android:key="section_search"
            android:title="@string/setting_title_search_engine" />

        <Preference
            android:icon="@drawable/icon_secure"
            android:key="section_privacy"
            android:title="@string/setting_section_privacy" />

        <!-- 15.2.1: the shield is called xGuard and has a topic of its own. -->
        <Preference
            android:icon="@drawable/icon_shield"
            android:key="section_xguard"
            android:title="@string/setting_section_xguard" />

        <Preference
            android:icon="@drawable/icon_house"
            android:key="section_home_custom"
            android:title="@string/setting_section_home_custom" />

        <!-- 18.0.0: the profiles are managed from here as well as from the sheet. The row is
             opened in code (SettingsScreens.bindProfiles): an intent element that carries only a
             target class has no package, so androidx.preference found no activity to start and
             tapping the row crashed the app with ActivityNotFoundException (beta 1, fixed in
             beta 2). -->
        <Preference
            android:icon="@drawable/icon_profile_standard"
            android:key="section_profiles"
            android:title="@string/profiles_title" />

        <Preference
            android:icon="@drawable/icon_tab"
            android:key="section_tabs"
            android:title="@string/setting_section_tabs" />

    </PreferenceCategory>

    <PreferenceCategory>

        <Preference
            android:icon="@drawable/icon_theme"
            android:key="section_appearance"
            android:title="@string/setting_section_appearance" />

        <Preference
            android:icon="@drawable/icon_layout"
            android:key="section_layout"
            android:title="@string/setting_section_layout" />

        <Preference
            android:icon="@drawable/icon_accessibility"
            android:key="section_accessibility"
            android:title="@string/setting_section_accessibility" />



        <!-- 17.3.1: extensions from the Chrome Web Store. -->
        <Preference
            android:icon="@drawable/icon_extension"
            android:key="section_extensions"
            android:title="@string/extensions_title" />

        <Preference
            android:icon="@drawable/icon_tune"
            android:key="section_site"
            android:title="@string/setting_section_site" />

        <!-- 18.3.0 beta (item 12): the downloads, with the folder they go to. -->
        <Preference
            android:icon="@drawable/icon_download"
            android:key="section_downloads"
            android:title="@string/setting_section_downloads" />

        <Preference
            android:icon="@drawable/icon_database"
            android:key="settings_data"
            android:title="@string/setting_title_data" />

    </PreferenceCategory>

    <PreferenceCategory>

        <Preference
            android:icon="@drawable/icon_help"
            android:key="section_help"
            android:title="@string/setting_section_help" />

        <Preference
            android:icon="@drawable/icon_info"
            android:key="section_about"
            android:title="@string/setting_section_about" />

    </PreferenceCategory>

</PreferenceScreen>
