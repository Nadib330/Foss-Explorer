<?xml version="1.0" encoding="utf-8"?>
<!-- Settings > About Explorer, like "About Chrome": the application version and the
     dedicated update check are separate cards, followed by the operating system, legal
     information, and developer entries. -->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory>

        <Preference
            android:key="about_app"
            android:title="@string/cr_application_version_title"
            android:selectable="false" />

    </PreferenceCategory>

    <PreferenceCategory>

        <Preference
            android:key="about_updates"
            android:summary="@string/about_check_updates_summary"
            android:title="@string/about_check_updates_title"
            android:selectable="true" />

    </PreferenceCategory>

    <PreferenceCategory>

        <Preference
            android:key="about_os"
            android:title="@string/cr_os_version_title"
            android:selectable="false" />

    </PreferenceCategory>

    <PreferenceCategory>

        <Preference
            android:key="section_legal"
            android:title="@string/cr_legal_information_title" />

    </PreferenceCategory>

    <PreferenceCategory>

        <Preference
            android:key="section_developer"
            android:summary="@string/about_developer_name"
            android:title="@string/about_developer_title" />

    </PreferenceCategory>

</PreferenceScreen>
