<?xml version="1.0" encoding="utf-8"?>
<!-- A round sample of a colour, with a thin rim so that a light colour shows on a light ground.
     The colour is set as a tint on the inner disc. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/colorOutline" />
        </shape>
    </item>
    <item
        android:id="@+id/color_dot_fill"
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>
